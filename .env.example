DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-for-local-development
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.test
SITE_BASE_URL=https://example.invalid
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_MAX_ATTEMPTS=3
SCHEDULER_POLL_SECONDS=15
SCHEDULER_HEARTBEAT_STALE_SECONDS=180
DOMAIN=example.invalid
APP_IMAGE=ai-smart-city:initial
APP_IMAGE_PREVIOUS=
BACKUP_DIR=/var/backups/ai-smart-city
REPORT_POST_LIMIT=5
REPORT_POST_WINDOW_SECONDS=3600
REPORT_MAX_PHOTOS=3
EVIDENCE_DISPLAY_MAX_EDGE=1600
LIST_PAGE_SIZE=20
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CSP_REPORT_ONLY=
COMPLAINT_RETENTION_DAYS=365
CLOSED_PHOTO_RETENTION_DAYS=365
REJECTED_CANCELLED_RETENTION_DAYS=183
INACTIVE_ACCOUNT_RETENTION_DAYS=730
DELETION_REQUEST_DAYS=30
PRIVACY_NOTICE_VERSION=2026-11-25-v1
CITIZEN_REMINDER_DAYS=3
DEMO_SEED=0
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
POSTGRES_DB=smart_city
POSTGRES_USER=smart_city
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
